#!/usr/local/bin/node
import fs from 'node:fs'
import { execFileSync } from 'node:child_process'
async function main() {
  const [op, ...args] = process.argv.slice(2)
  if (op === 'install-skill' && args.length === 1) {
    execFileSync('flock', ['/tmp/qq-install-skill.lock', process.execPath, '/opt/harness/install_skill.mjs', args[0]], { stdio: 'inherit' })
    return
  }
  if (
    ![
      'tools',
      'install-deb',
      'fetch-skill',
      'media',
      'progress',
      'call',
      'resource',
      'searchWeb',
      'readWebPage',
      'fetchImage',
      'searchGroupMemory',
      'searchHistory',
    ].includes(op) ||
    (op !== 'tools' && !args.length)
  )
    throw Error(
      'qq-tool tools | fetch-skill OWNER/REPO | install-skill DIRECTORY | install-deb PACKAGE | searchWeb QUERY | readWebPage URL | searchGroupMemory JSON | searchHistory JSON | fetchImage POST_URL IMAGE_HANDLE_OR_MEDIA_URL',
    )
  let token = process.env.QQ_TASK_TOKEN
  // Some SDK shells filter environment variables. Resolve our own supervisor even after chdir.
  for (let pid = process.ppid; !token && pid > 1;) {
    try { token = fs.readFileSync('/tmp/qq-agents/lease-' + pid, 'utf8') }
    catch (error) { if (error.code !== 'ENOENT') throw error }
    const stat = fs.readFileSync('/proc/' + pid + '/stat', 'utf8')
    pid = Number(stat.slice(stat.lastIndexOf(')') + 2).split(' ')[1])
  }
  if (!token) throw Error('本次任务凭证已失效')
  const request = () => fetch('http://app:8790/task/' + op, {
    method: 'POST',
    headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
    body: JSON.stringify({ args }),
  })
  const response = await request()
  let result = await response.json()
  if (!response.ok) throw Error(result.error || '请求失败')
  if (op === 'media' || op === 'resource' || (op === 'call' && result.resource && typeof result.data==='string')) {
    while (result.pending) {
      await new Promise(done => setTimeout(done, 5000))
      const poll = await request()
      result = await poll.json()
      if (!poll.ok) throw Error(result.error || '读取媒体任务状态失败')
    }
    if (typeof result.data === 'string' && result.resource) {
      if (!/^[a-f0-9]{32}$/.test(result.resource)) throw Error('无效的素材句柄')
      const extension = {'image/jpeg':'jpg','image/png':'png','image/webp':'webp','video/mp4':'mp4',
        'audio/mpeg':'mp3','audio/mp3':'mp3','audio/wav':'wav','audio/x-wav':'wav'}[result.mime] || 'bin'
      const path = 'inputs/' + result.resource + '.' + extension
      fs.mkdirSync('inputs', {recursive:true})
      fs.writeFileSync(path, Buffer.from(result.data, 'base64'))
      console.log(JSON.stringify({resource:result.resource,path,mime:result.mime,applied:result.applied}))
    } else console.log(JSON.stringify(result))
    return
  }
  if (op === 'fetch-skill') {
    execFileSync('python3', ['/opt/harness/unpack_skills.py'], {
      input: Buffer.from(result.data, 'base64'), stdio: ['pipe', 'inherit', 'inherit'],
    })
    return
  }
  if (op === 'fetchImage') {
    const extension = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' }[result.mime]
    if (!extension || !/^[a-f0-9]{32}$/.test(result.resource)) throw Error('无效的图片')
    const path = 'inputs/' + result.resource + '.' + extension
    fs.mkdirSync('inputs', { recursive: true })
    fs.writeFileSync(path, Buffer.from(result.data, 'base64'))
    execFileSync(
      '/usr/bin/ffmpeg',
      [
        '-nostdin',
        '-v',
        'error',
        '-protocol_whitelist',
        'file,pipe',
        '-i',
        path,
        '-frames:v',
        '1',
        '-f',
        'null',
        '-',
      ],
      { timeout: 15000 },
    )
    console.log(JSON.stringify({ path, resource: result.resource, source: result.source }))
    return
  }
  console.log(JSON.stringify(result))
}
main().catch((e) => {
  console.error(e.message)
  process.exitCode = 1
})
