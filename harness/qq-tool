#!/usr/local/bin/node
const fs = require('node:fs')
const { execFileSync } = require('node:child_process')
async function main() {
  const [op, ...args] = process.argv.slice(2)
  if (op === 'install-skill' && args.length === 1) {
    execFileSync(process.execPath, ['/opt/harness/install_skill.mjs', args[0]], { stdio: 'inherit' })
    return
  }
  if (
    ![
      'install-deb',
      'searchWeb',
      'readWebPage',
      'fetchImage',
      'searchGroupMemory',
      'searchHistory',
    ].includes(op) ||
    !args.length
  )
    throw Error(
      'qq-tool install-deb PACKAGE | searchWeb QUERY | readWebPage URL | searchGroupMemory JSON | searchHistory JSON | fetchImage POST_URL IMAGE_HANDLE_OR_MEDIA_URL',
    )
  const token = fs.readFileSync('/tmp/qq-task-lease', 'utf8')
  const response = await fetch('http://app:8790/task/' + op, {
    method: 'POST',
    headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
    body: JSON.stringify({ args }),
  })
  const result = await response.json()
  if (!response.ok) throw Error(result.error || '请求失败')
  if (op === 'fetchImage') {
    const extension = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' }[result.mime]
    if (!extension || !/^[a-f0-9]{32}$/.test(result.resource)) throw Error('无效的图片')
    const path = 'inputs/' + result.resource + '.' + extension
    fs.mkdirSync('inputs', { recursive: true })
    fs.writeFileSync(path, Buffer.from(result.data, 'base64'))
    execFileSync(
      '/usr/bin/ffmpeg',
      [
        '-nostdin',
        '-v',
        'error',
        '-protocol_whitelist',
        'file,pipe',
        '-i',
        path,
        '-frames:v',
        '1',
        '-f',
        'null',
        '-',
      ],
      { timeout: 15000 },
    )
    console.log(JSON.stringify({ path, resource: result.resource, source: result.source }))
    return
  }
  console.log(JSON.stringify(result))
}
main().catch((e) => {
  console.error(e.message)
  process.exitCode = 1
})
