{
  "name": "qq-superagent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "esbuild vendor/superagent/src/core/index.ts --bundle --platform=node --format=esm --outfile=build/core.mjs",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "start": "node app/server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "ipaddr.js": "2.2.0",
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
